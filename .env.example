AUTH_DB_PASSWORD=changeme-auth
USERS_DB_PASSWORD=changeme-users
PRODUCTS_DB_PASSWORD=changeme-products
ORDERS_DB_PASSWORD=changeme-orders
PAYMENTS_DB_PASSWORD=changeme-payments

JWT_SECRET=dev-only-change-me-min-32-chars-0000

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Storage de imágenes (Azurite / Azure Blob Storage) ---------------------
# El default de compose.yaml ya trae la clave fija de Azurite para
# "devstoreaccount1" (no es un secreto: la publica Microsoft en su imagen),
# asi que NO hace falta definirla para levantar el stack local.
# Solo defina la variable para apuntar a otro storage (p. ej. Azure Blob
# Storage real); debe coincidir con la clave de la cuenta, si no, cada
# request al storage responde 403 AuthorizationFailure.
# AZURE_STORAGE_KEY=


GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

TRACING_SAMPLING_PROBABILITY=0.1
