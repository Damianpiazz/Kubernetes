# =============================================================================
# Plantilla de entorno local — copiar a .env y completar:
#   cp .env.example .env
#
# .env esta excluido de Git. NUNCA commitear contraseñas reales ni tokens.
# =============================================================================

# --- Bases de datos (5 instancias independientes, una por servicio) ---------
AUTH_DB_PASSWORD=changeme-auth
USERS_DB_PASSWORD=changeme-users
PRODUCTS_DB_PASSWORD=changeme-products
ORDERS_DB_PASSWORD=changeme-orders
PAYMENTS_DB_PASSWORD=changeme-payments

# --- Seguridad compartida ---------------------------------------------------
# HS256, >= 32 caracteres. Lo usa auth-service para emitir y gateway para
# validar. Si no coincide entre ambos, todos los tokens se rechazan con 401.
JWT_SECRET=local-dev-secret-please-change-32chars

# --- Mercado Pago (opcional en dev) -----------------------------------------
# Sin access token el servicio arranca igual, pero crear un pago responde 503.
# Sin webhook secret, las notificaciones recibidas se ignoran (firmas invalidas).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
