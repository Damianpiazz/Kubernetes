# Plantilla de secretos de PRODUCCIÓN (apps · namespace latiendita).
#
#   cp k8s/apps/environments/production/secrets.env.example \
#      k8s/apps/environments/production/secrets.env
#
# El archivo real es gitignored: nunca se commitea. Reemplazar todos los
# CHANGE-ME por valores reales generados (p. ej. `openssl rand -base64 48`);
# `deploy.sh`/`deploy.ps1` fallan con código 6 si el target contiene
# "production" y algún valor sigue siendo de plantilla.
#
# Las claves son las mismas que consumen los manifiestos vía secretKeyRef
# (9 referencias en los 6 Deployments); ver docs/kubernetes/configuracion.md §8.

# Clave de firma/verificación de JWT (obligatoria, mín. 32 caracteres).
JWT_SECRET=CHANGE-ME-jwt-secret

# Contraseñas de las bases de datos GESTIONADAS (externas al clúster).
AUTH_DB_PASSWORD=CHANGE-ME-auth-db
USERS_DB_PASSWORD=CHANGE-ME-users-db
PRODUCTS_DB_PASSWORD=CHANGE-ME-products-db
ORDERS_DB_PASSWORD=CHANGE-ME-orders-db
PAYMENTS_DB_PASSWORD=CHANGE-ME-payments-db

# Mercado Pago: vacío ⇒ la feature queda deshabilitada (deploy solo avisa).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
