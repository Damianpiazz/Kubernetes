# Credenciales de Grafana para el environment local (kind / k3d).
# El destino secrets.env es gitignored (patrón k8s/**/secrets.env): no se
# commitea. Generar (o verificar) con:
#
#   scripts/secrets.ps1 observability-local    (o)    scripts/secrets.sh observability-local
#
# El script conserva el usuario y genera una contraseña aleatoria fuerte
# (claves *_ADMIN_PASSWORD). No usar credenciales por defecto commiteadas.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE-ME
