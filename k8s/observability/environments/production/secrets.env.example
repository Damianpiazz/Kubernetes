# Secretos de PRODUCCIÓN del stack de observabilidad (namespace
# latiendita-observability). El archivo real secrets.env es gitignored.
#
#   cp k8s/observability/environments/production/secrets.env.example \
#      k8s/observability/environments/production/secrets.env
#
# Claves inyectadas vía envFrom al Deployment de Grafana (secretRef
# grafana-admin). deploy.* falla con exit 6 si el target contiene
# "production" y algún valor sigue siendo de plantilla (CHANGE-ME).

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE-ME-grafana-admin
