// Grafana Alloy en Kubernetes.
//
// Diferencia con alloy/config.alloy (Docker): los logs no salen del docker.sock
// sino que se leen desde la API de Kubernetes (loki.source.kubernetes), por lo
// que no hace falta hostPath ni privilegios especiales. El pipeline de parseo es
// idéntico al de Docker, así los labels de Loki son los mismos en ambos entornos.
logging {
  level = "info"
}

// ── Traces ───────────────────────────────────────────────────────────────────
// Las apps envían OTLP a http://alloy.latiendita-observability.svc:4318/v1/traces
// (variable OTLP_TRACING_ENDPOINT en k8s/apps/base/<servicio>/configmap.yaml) y Alloy
// reenvía a Tempo, igual que en Docker.
otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ── Logs ─────────────────────────────────────────────────────────────────────
// Todos los contenedores del namespace de las aplicaciones (incluye bases de
// datos y Kafka: sus logs son útiles durante un incidente).
discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    names = ["latiendita"]
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    target_label  = "job"
    replacement = "latiendita"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.apps.receiver]
}

// Mismo pipeline que en Docker: extrae level, application_name y traceId del
// JSON estructurado y promueve level/application_name a labels de Loki.
// application_name es el label que usa Tempo (tracesToLogs: service.name ->
// application_name) y el panel "Application logs" del dashboard.
loki.process "apps" {
  stage.json {
    expressions = {
      level            = "level",
      application_name = "application_name",
      traceId          = "traceId",
    }
  }

  stage.labels {
    values = {
      level            = "level",
      application_name = "application_name",
    }
  }

  output {
    receiver = loki.write.loki.receiver
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
