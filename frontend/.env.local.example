# URL base del gateway. Local: http://localhost:8080 (compose o port-forward).
# Producción: NO se configura acá — Next inlinea NEXT_PUBLIC_* en build, así
# que el Dockerfile la recibe como build-ARG:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://<dominio> ./frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Modo de datos: 'api' (default) contra el gateway, o 'mock' para una demo sin
# backend. En modo mock los datos (usuarios, catálogo, pedidos y pagos) viven en
# el bundle, el pago simulado se aprueba en /checkout/simulate y los cambios se
# guardan en localStorage. También es build-ARG: --build-arg NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_DATA_MODE=api
