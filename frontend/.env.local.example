# URL base del gateway. Local: http://localhost:8080 (compose o port-forward).
# Producción: NO se configura acá — Next inlinea NEXT_PUBLIC_* en build, así
# que el Dockerfile la recibe como build-ARG:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://<dominio> ./frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
